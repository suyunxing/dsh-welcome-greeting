{
  "name": "dsh-welcome-greeting",
  "version": "1.0.0",
  "type": "module",
  "description": "Time, place and weather aware welcome headline for the New Session hero.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "icon-180.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "author": "suyunxing <suyunxings@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suyunxing/dsh-welcome-greeting.git"
  },
  "homepage": "https://github.com/suyunxing/dsh-welcome-greeting",
  "bugs": {
    "url": "https://github.com/suyunxing/dsh-welcome-greeting/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "welcome",
    "greeting",
    "hero",
    "weather"
  ],
  "engines": {
    "node": ">=22"
  }
}
